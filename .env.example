# Application General Settings
APP_NAME="Sufi Pharmacy & Wellness"
APP_URL="http://localhost:3000"
APP_CURRENCY="PKR"
APP_COUNTRY="Pakistan"
APP_TIMEZONE="Asia/Karachi"

# Database Configuration (PostgreSQL 16+)
# For local Docker: postgresql://postgres:postgres@localhost:5432/pharmacy_db?schema=public
# For Neon / Supabase: Pooled URL with pgbouncer for DATABASE_URL, direct connection for DIRECT_URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/pharmacy_db?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/pharmacy_db?schema=public"

# Authentication Security (Auth.js / NextAuth)
# Generate with: openssl rand -base64 32
AUTH_SECRET="e9d480c2cf5bb1469e35d21c32616da2b8b9dc4901f654b9d5c80ef2448373a1"
NEXTAUTH_URL="http://localhost:3000"

# Initial Super Admin Seed Credentials
ADMIN_NAME="Pharmacy Administrator"
ADMIN_EMAIL="admin@pharmacy.local"
ADMIN_PASSWORD="Admin@Pharmacy2026!"

# File Storage Configuration (Local or S3/Cloudflare R2 for prescription attachments)
# Options: "local" | "s3"
FILE_STORAGE_PROVIDER="local"
FILE_STORAGE_BUCKET="pharmacy-prescriptions"
